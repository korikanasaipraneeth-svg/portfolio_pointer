# PRANEETH.AI — Production Environment Configuration Template
# Server-side variables. Sensitive credentials should only be configured in Vercel / Render dashboard.

# Production URLs & Routing
NEXT_PUBLIC_APP_URL=https://praneeth.ai
# Set on Vercel to route /api/* requests to your deployed Render backend:
RENDER_BACKEND_URL=https://praneeth-portfolio-backend.onrender.com

# Optional: GitHub Personal Access Token (increases rate limit from 60/hr to 5000/hr)
GITHUB_TOKEN=

# Optional: SMTP Email Gateway for /api/contact live delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=korikanasaipraneeth@gmail.com
SMTP_PASS=
CONTACT_TO_EMAIL=korikanasaipraneeth@gmail.com

# Server Port (Render sets this automatically to 10000)
PORT=3000
NODE_ENV=production

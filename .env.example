# PRANEETH.AI — Environment Configuration Template
# All keys are server-side only and optional. System runs gracefully with 100% functionality without paid keys.

# Optional: GitHub Personal Access Token (to increase GitHub API rate limits from 60/hr to 5000/hr)
GITHUB_TOKEN=

# Optional: Server-Side AI Execution Provider (Mode B in Autonomous Development Environment)
# If left blank, the ADE operates in high-performance Mode A (Deterministic Local Simulation)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: Transactional Email Gateway for /api/contact (e.g. Resend, SendGrid)
# If left blank, inquiries are securely logged to the server terminal with verification IDs
RESEND_API_KEY=

# Next.js Port
PORT=3000
